# Butchr local daemon — systemd USER unit.
#
# TEMPLATE. The @@ tokens are substituted with absolute paths by
# daemon/scripts/install-service.sh before the file is copied into
# ~/.config/systemd/user/. Do not point systemd at this file in place.
#
# Named butchr-daemon, not butchr: an unrelated project of the same name ships
# a `butchr.service` user unit, and installing over it would silently replace
# someone else's service. The daemon this repo builds is always butchr-daemon.
[Unit]
Description=Butchr local daemon (Chrome native-messaging bridge to herdr)
Documentation=https://github.com/wroosbit/butchr/blob/main/docs/SETUP.md
# herdr owns the panes the daemon attaches to. The daemon starts fine without
# it and logs a warning, so this is a soft Wants + After — not a Requires that
# would drag the daemon down every time herdr restarts.
Wants=herdr.service
After=herdr.service
# Start rate limiting lives in [Unit], not [Service] — systemd ignores it with
# "Unknown key name" in the wrong section, which it says once in the journal
# and never again. Caught on the clean-machine run.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@@REPO@@
# The daemon reads prompts/*.md relative to the repo root and re-resolves PATH
# at startup from the login shell, but the user manager's own PATH is minimal
# and is what the shell probe falls back to. Spell out where tools live.
Environment=PATH=@@NODE_BIN_DIR@@:%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@@NODE@@ @@REPO@@/daemon/dist/daemon.js

# on-failure, deliberately not always. The daemon exits 0 in two situations
# that must stay exited: a deliberate SIGTERM, and losing the race for the
# socket to a daemon that is ALREADY THE CONFIGURED ONE. Restart=always would
# relaunch that loser every RestartSec until the start limit stopped the unit,
# turning a correct no-op into a crash-looping service.
#
# KAN-550 narrowed the second case, and the narrowing is why on-failure is now
# load-bearing rather than merely harmless. This comment used to say the loser
# exits 0 whenever anything else holds the socket, and that was true and was
# the defect: on 2026-08-20 the winner was an unconfigured child of Chrome
# carrying no BUTCHR_* at all, so the runtime pin and the agent cap were
# silently dropped — and because the loser exited CLEANLY, systemd had nothing
# to retry, `systemctl start` reported success while leaving nothing running,
# and this unit read `inactive` for two minutes while the fleet ran wrong.
#
# The loser now asks the winner who it is (`daemon_provenance` over the socket)
# and exits on the answer:
#
#   0  the winner is systemd's and carries the pinned environment -> a no-op,
#      exactly as before, and nothing here restarts.
#   3  the winner is unconfigured, or would not say -> Restart=on-failure
#      retries, and after StartLimitBurst above the unit lands in `failed`.
#   4  this process itself would have come up without the runtime this machine
#      pins, and refused to serve rather than do it silently.
#
# `failed` is the point. It is a state `is-active` can already show an
# operator, and it is the one thing the 2026-08-20 incident could not produce.
Restart=on-failure
RestartSec=2

# The daemon itself holds few descriptors — one pty per attached sidepanel —
# so this is headroom, not the fix for the pane ceiling. The limit that
# matters is herdr's; see herdr.service.d/10-butchr-nofile.conf.
LimitNOFILE=65536:1048576

SyslogIdentifier=butchr-daemon

[Install]
WantedBy=default.target
