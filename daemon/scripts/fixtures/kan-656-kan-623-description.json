            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Put the general rule where a reader of §8 or of the environment step will also meet it, not only inside the optional channels step. A reader who never turns channels on must still learn it."
                    }
